# Copy to .env and adjust. Used by docker-compose.

# Database
SARAH_DB_NAME=sarah
SARAH_DB_USERNAME=sarah
SARAH_DB_PASSWORD=sarah

# Owner (seeded on first run) — CHANGE THE PASSWORD
SARAH_ADMIN_EMAIL=owner@oreostudios.com
SARAH_ADMIN_PASSWORD=change-me-now

# AES-256-GCM key for encrypting connector tokens at rest.
# Generate with:  openssl rand -base64 32
SARAH_TOKEN_KEY=

# LLM provider: mock (offline, default) | anthropic
SARAH_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
SARAH_LLM_MODEL=claude-opus-4-8

# CORS origin of the frontend (not needed when using the bundled nginx proxy)
SARAH_CORS_ORIGINS=http://localhost:8088

# --- Conversational (email-OTP) authentication ---
# Stable secret for HMAC-ing verification codes. Any long random string. REQUIRED in production.
SARAH_AUTH_HMAC_SECRET=
# Email delivery: log (dev, no real send) | smtp (real, via the SMTP settings below)
SARAH_AUTH_EMAIL_PROVIDER=log
SARAH_AUTH_EMAIL_FROM=Sarah <sarah@oreostudios.com>
# SMTP (only used when provider=smtp). For local testing, run Mailhog and point here.
SARAH_MAIL_HOST=
SARAH_MAIL_PORT=587
SARAH_MAIL_USERNAME=
SARAH_MAIL_PASSWORD=
# Set true when serving over HTTPS so the session cookie is marked Secure.
SARAH_COOKIE_SECURE=false

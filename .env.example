# Copy to .env and adjust. Used by docker-compose.

# Database
SARAH_DB_NAME=sarah
SARAH_DB_USERNAME=sarah
SARAH_DB_PASSWORD=sarah

# Owner (seeded on first run) — CHANGE THE PASSWORD
SARAH_ADMIN_EMAIL=owner@oreostudios.com
SARAH_ADMIN_PASSWORD=change-me-now

# AES-256-GCM key for encrypting connector tokens at rest.
# Generate with:  openssl rand -base64 32
SARAH_TOKEN_KEY=

# LLM provider: mock (offline, default) | anthropic | openai
SARAH_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
SARAH_LLM_MODEL=claude-opus-4-8

# CORS origin of the frontend (not needed when using the bundled nginx proxy)
SARAH_CORS_ORIGINS=http://localhost:8088

# --- Conversational (email-OTP) authentication ---
# Stable secret for HMAC-ing verification codes. Any long random string. REQUIRED in production.
SARAH_AUTH_HMAC_SECRET=
# Email delivery: log (dev, no real send) | smtp (real, via the SMTP settings below)
SARAH_AUTH_EMAIL_PROVIDER=log
SARAH_AUTH_EMAIL_FROM=Sarah <sarah@oreostudios.com>
# SMTP (only used when provider=smtp). For local testing, run Mailhog and point here.
SARAH_MAIL_HOST=
SARAH_MAIL_PORT=587
SARAH_MAIL_USERNAME=
SARAH_MAIL_PASSWORD=
# Set true when serving over HTTPS so the session cookie is marked Secure.
SARAH_COOKIE_SECURE=false

# Optional marketing integrations (disabled until configured)
OPENAI_API_KEY=
SARAH_OPENAI_MODEL=gpt-4.1-mini
SARAH_MEMORY_ENABLED=false
SARAH_SOCIAL_LINKEDIN_ENABLED=false
SARAH_LINKEDIN_API_VERSION=
SARAH_SOCIAL_FACEBOOK_ENABLED=false
SARAH_FACEBOOK_API_VERSION=
SARAH_WEBSITE_WORDPRESS_ENABLED=false
SARAH_WORDPRESS_URL=
SARAH_SEARCH_CONSOLE_ENABLED=false
SARAH_GSC_PROPERTY=
SARAH_GSC_CLIENT_ID=
SARAH_GSC_CLIENT_SECRET=
SARAH_GSC_REFRESH_TOKEN=
SARAH_OUTBOUND_HOSTS=discord.com,discordapp.com

# Instagram / Reddit (owner-reviewed publishing only)
SARAH_SOCIAL_INSTAGRAM_ENABLED=false
SARAH_INSTAGRAM_API_VERSION=
SARAH_SOCIAL_REDDIT_ENABLED=false
SARAH_REDDIT_USER_AGENT=

# Autonomous marketing features (opt-in)
SARAH_BRAVE_SEARCH_KEY=
SARAH_PROSPECTING_ENABLED=false
SARAH_PROSPECTING_QUERY=
SARAH_PROSPECTING_POSTAL_CODE=
SARAH_PROSPECTING_ACTIVITY_PREFIX=
SARAH_PROSPECTING_CRON="0 15 7 * * *"
SARAH_IMAGE_ENABLED=false
SARAH_IMAGE_MODEL=gpt-image-1.5
SARAH_IMAGE_DAILY_LIMIT=3
SARAH_EMAIL_MARKETING_ENABLED=false
SARAH_MARKETING_FROM=
SARAH_MARKETING_REPLY_TO=
SARAH_MARKETING_POSTAL_ADDRESS=
SARAH_MARKETING_PUBLIC_URL=
SARAH_MARKETING_EMAIL_DAILY_LIMIT=10
SARAH_OPTIMIZATION_ENABLED=false
SARAH_OPTIMIZATION_CRON="0 0 7 * * *"
SARAH_DAILY_PLAN_ENABLED=false
SARAH_DAILY_AUTO_PUBLISH=false
SARAH_DAILY_OBJECTIVE=
SARAH_DAILY_AUDIENCE=
SARAH_DAILY_LANGUAGE=en
SARAH_DAILY_PLATFORMS=discord
SARAH_DAILY_MAX_CHANNELS=2
SARAH_DAILY_PLAN_CRON="0 30 7 * * *"
